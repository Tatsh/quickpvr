#include <windows.h>

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE @QUICKPVR_RESOURCE_FILE_TYPE@
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "@PROJECT_HOMEPAGE_URL@\0"
            VALUE "CompanyName", "@QUICKPVR_COMPANY@\0"
            VALUE "FileDescription", "@QUICKPVR_RESOURCE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "@QUICKPVR_RESOURCE_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "@QUICKPVR_COPYRIGHT@\0"
            VALUE "OriginalFilename", "@QUICKPVR_RESOURCE_FILENAME@\0"
            VALUE "ProductName", "QuickPVR\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
