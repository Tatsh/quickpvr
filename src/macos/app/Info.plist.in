      <string>public.pvr</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>pvr</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
